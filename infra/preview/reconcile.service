[Unit]
Description=Reconcile PlanetScale branches and Coolify applications
After=docker.service network-online.target

[Service]
Type=oneshot
Environment=PREVIEW_ROOT=/data/monoweb-previews
ExecStart=/usr/bin/python3 /opt/monoweb-previews/controller/previewctl.py reconcile
UMask=0077
TimeoutStartSec=15min
