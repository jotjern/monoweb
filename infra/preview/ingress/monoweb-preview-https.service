[Unit]
Description=Forward preview HTTPS to the isolated VPS
Requires=monoweb-preview-https.socket
After=network-online.target

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 192.168.73.66:443
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=64M
