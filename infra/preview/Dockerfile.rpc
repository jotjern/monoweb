# syntax=docker/dockerfile:1.7
FROM node:22.23.3-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/rpc/package.json apps/rpc/package.json
COPY apps/grades-backend/package.json apps/grades-backend/package.json
COPY apps/grades-frontend/package.json apps/grades-frontend/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/grades-db/package.json packages/grades-db/package.json
COPY packages/environment/package.json packages/environment/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/utils/package.json packages/utils/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts --prod
COPY --chown=node:node . .
ENV NODE_ENV=production OTEL_SDK_DISABLED=1 AWS_EC2_METADATA_DISABLED=true
USER node
EXPOSE 4444
CMD ["node", "--loader", "./apps/rpc/runtime.mjs", "--experimental-strip-types", "./apps/rpc/src/bin/server.ts"]
